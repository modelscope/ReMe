EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional Jev classification: install reme-ai[core,classifier-jev].
# Setting these variables alone does not enable a classifier component.
# CLASSIFIER_API_KEY=your-typesafe-api-key
# CLASSIFIER_BACKEND=jev
# CLASSIFIER_MODEL_NAME=jev-latest
# CLASSIFIER_BASE_URL=null

# Optional data-source mirrors. Unset variables use the official services.
# HF_MIRROR_URL=https://hf-mirror.com
# ARXIV_MIRROR_URL=https://export.arxiv.org
# TUSHARE_MIRROR_URL=http://112.124.63.173:4000/tushare
